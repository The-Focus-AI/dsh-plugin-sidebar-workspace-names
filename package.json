{
  "name": "dsh-plugin-sidebar-workspace-names",
  "version": "0.1.0",
  "description": "Shows the owning workspace name on a second line under each session title in the DeepSeek Harness sidebar's In one list view.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "sidebar",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Focus-AI/dsh-plugin-sidebar-workspace-names.git"
  },
  "homepage": "https://github.com/The-Focus-AI/dsh-plugin-sidebar-workspace-names#readme",
  "bugs": {
    "url": "https://github.com/The-Focus-AI/dsh-plugin-sidebar-workspace-names/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
